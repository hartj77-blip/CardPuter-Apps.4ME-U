# The Car app's USB modes (README.md), on the USB device port: USB stick
# mode (a copy of ~/Music) or USB live sound (what plays now). The Car app
# names the mode, then starts and stops this. Building the music image the
# first time can take a while, hence the long start timeout.
[Unit]
Description=ZeroOS Car: music for a car stereo over USB

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/zeroos/usb-stick start
ExecStop=/usr/lib/zeroos/usb-stick stop
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=idle
