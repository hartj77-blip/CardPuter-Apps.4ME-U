@@ -385,6 +385,52 @@ func processFrames(frameTransport ipod.FrameReadWriter) {
 
 var devGeneral = &DevGeneral{}
 
+// emitButton reports an accessory button press as one "button <name>" line
+// on stdout. os.Stdout is unbuffered, so every line is a single write(2).
+func emitButton(name string) {
+	fmt.Fprintf(os.Stdout, "button %s\n", name)
+}
+
+// last ContextButtonStatus bitmask; the accessory repeats the status while
+// a button is held and sends 0 on release, so only 0->1 edges are reported.
+var prevContextButtons simpleremote.ContextButtonMask
+
+var contextButtonNames = []struct {
+	bit  simpleremote.ContextButtonBit
+	name string
+}{
+	{simpleremote.ContextButtonPlayPause, "playpause"},
+	{simpleremote.ContextButtonPlayResume, "play"},
+	{simpleremote.ContextButtonPause, "pause"},
+	{simpleremote.ContextButtonNextTrack, "next"},
+	{simpleremote.ContextButtonPreviousTrack, "previous"},
+}
+
+func handleContextButtons(state simpleremote.ContextButtonMask) {
+	pressed := state &^ prevContextButtons
+	prevContextButtons = state
+	for _, b := range contextButtonNames {
+		if uint32(pressed)&uint32(b.bit) != 0 {
+			emitButton(b.name)
+		}
+	}
+}
+
+func handlePlayControl(c extremote.PlayControlCmd) {
+	switch c {
+	case extremote.PlayControlToggle:
+		emitButton("playpause")
+	case extremote.PlayControlPlay:
+		emitButton("play")
+	case extremote.PlayControlPause:
+		emitButton("pause")
+	case extremote.PlayControlNextTrack, extremote.PlayControlNext:
+		emitButton("next")
+	case extremote.PlayControlPrevTrack, extremote.PlayControlPrev:
+		emitButton("previous")
+	}
+}
+
 func handlePacket(cmdWriter ipod.CommandWriter, cmd *ipod.Command) {
 	switch cmd.ID.LingoID() {
 	case ipod.LingoGeneralID:
@@ -396,11 +442,17 @@ func handlePacket(cmdWriter ipod.CommandWriter, cmd *ipod.Command) {
