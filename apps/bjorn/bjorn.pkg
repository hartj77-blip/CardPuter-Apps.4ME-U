# Bjorn (README.md): the original Bjorn (infinition/Bjorn) autonomous network
# recon tool and its web UI, packaged to run headless on ZeroOS -- no e-paper
# HAT, the Python service in the background, its dashboard on :8000, and a
# ZeroShell control panel. The source is vendored at a pinned commit by
# prepare.sh, which also drops in the mock display driver.
NAME="Bjorn"
SUMMARY="The original Bjorn: autonomous network recon with its web dashboard on :8000"
APP_VERSION="1.0.1"
# Debian's own packages for Bjorn's core, so apt resolves them with no pip. The
# web UI is Python's own http.server (no Flask). Pillow (the rendered screen),
# numpy, rich, pandas, netifaces, paramiko (SSH), pymysql, sqlalchemy,
# python-nmap; the command-line tools it drives: nmap, arp-scan, ip (iproute2),
# arp (net-tools), nmcli (network-manager). rsync copies the code into the
# writable state dir on start; nftables gates who can reach the dashboard.
# Four of Bjorn's Python deps (ping3, get-mac, smbprotocol, pysmb) are not in
# Debian and are not installed here -- see the README's "To confirm" list.
DEPENDS="python3, python3-pil, python3-numpy, python3-rich, python3-pandas, python3-netifaces, python3-paramiko, python3-pymysql, python3-sqlalchemy, python3-nmap, nmap, arp-scan, iproute2, net-tools, network-manager, nftables, rsync"
NEEDS="Python, nmap, scapy"
# Not started at boot: the Bjorn app turns it on, and the dashboard stays
# firewalled to this device and your tailnet until you allow it on the network.
STOP_ON_REMOVE="zeroos-bjorn-lan.service bjorn.service"
payload() {
    # The pristine code tree (prepare.sh has already added epd_mock.py and set
    # epd_type to it). The service copies this into its writable state dir
    # (/var/lib/bjorn) on start, because Bjorn keeps its config, db, loot and
    # logs next to its own .py files (paths come from __file__).
    install -d "$D/usr/lib/zeroos/bjorn"
    cp -a "$WORK/bjorn/." "$D/usr/lib/zeroos/bjorn/"
    find "$D/usr/lib/zeroos/bjorn" -type d -exec chmod 0755 {} +
    find "$D/usr/lib/zeroos/bjorn" -type f -exec chmod 0644 {} +
    install -D -m 0644 "$F/bjorn.service" "$D/etc/systemd/system/bjorn.service"
    install -D -m 0644 "$F/zeroos-bjorn-lan.service" "$D/etc/systemd/system/zeroos-bjorn-lan.service"
    install -D -m 0755 "$F/zeroos-bjorn-firewall" "$D/usr/lib/zeroos/bjorn-firewall"
    # Let ZeroShell (pi) start and stop the service without root (like Router).
    install -D -m 0644 "$F/91-zeroos-bjorn.rules" "$D/etc/polkit-1/rules.d/91-zeroos-bjorn.rules"
    install -D -m 0644 "$F/THIRD_PARTY.md" "$D/usr/share/doc/zeroos-app-bjorn/THIRD_PARTY.md"
}
