# RF Tools (README.md): nine apps for an RTL-SDR dongle in one module, rf.so,
# and the radio programs they drive (core/, built into the build's bin/).
NAME="RF Tools"
SUMMARY="Spectrum, Scanner, Sensors, Aircraft, APRS, FT8, Logbook, SDR Server and Station, for an RTL-SDR dongle"
APP_VERSION="1.0.0"
DEPENDS="rtl-sdr, rtl-433, multimon-ng, libhamlib-utils, uhubctl, sox, usbutils"
NEEDS="rtl-sdr, rtl-433, multimon-ng, Hamlib"
payload() {
    local bin=${ZEROOS_BUILD:-}/bin p
    for p in zrfd zrf zrf-sim-sensors zrf-sim-aircraft zrf-sim-aprs; do
        [ -x "$bin/$p" ] || { echo "error: no $bin/$p" >&2; exit 1; }
    done
    # The device has librtlsdr.so.0 (Debian trixie). A zrfd built elsewhere
    # (Ubuntu: librtlsdr.so.2) won't start, and one built without the
    # library can't use a real dongle, so neither is packed.
    case $(readelf -d "$bin/zrfd" 2>/dev/null) in
        *'[librtlsdr.so.0]'*) ;;
        *librtlsdr*) echo "error: zrfd is linked to the wrong librtlsdr; build on Debian trixie" >&2; exit 1 ;;
        *) echo "error: this zrfd has no RTL-SDR support: build with librtlsdr-dev installed" >&2; exit 1 ;;
    esac
    install -d "$D/usr/bin"
    for p in zrfd zrf zrf-sim-sensors zrf-sim-aircraft zrf-sim-aprs; do
        install -m 0755 "$bin/$p" "$D/usr/bin/$p"
    done
    install -m 0755 "$F/bringup.sh" "$D/usr/bin/zeroos-rf-bringup"
    # Let the normal user open an RTL-SDR dongle, and keep the kernel's TV driver off it.
    install -D -m 0644 "$F/60-zeroos-rf.rules" "$D/etc/udev/rules.d/60-zeroos-rf.rules"
    install -D -m 0644 "$F/zeroos-rf-blacklist.conf" "$D/etc/modprobe.d/zeroos-rf-blacklist.conf"
    install -D -m 0644 "$F/THIRD_PARTY.md" "$D/usr/share/doc/zeroos-app-rf/THIRD_PARTY.md"
}
