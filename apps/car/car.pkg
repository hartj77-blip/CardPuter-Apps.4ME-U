# Car (README.md): USB stick mode for a car stereo, Bluetooth audio with
# the car's play and skip buttons, and a phone's music through the Cardputer.
NAME="Car"
SUMMARY="USB stick mode for a car stereo, Bluetooth audio with the car's buttons, your phone's music to the aux"
APP_VERSION="1.2.1"
DEPENDS="mtools, dosfstools, fdisk"
NEEDS="mtools"
STOP_ON_REMOVE="zeroos-usb-stick.service"
# BlueALSA (from the base image) takes a phone's music before PipeWire can,
# then can't play it ("Host is down"): turned off at install (README.md).
DISABLE_DEPS="bluealsa-aplay.service bluealsa.service"
payload() {
    install -D -m 0755 "$F/zeroos-usb-stick" "$D/usr/lib/zeroos/usb-stick"
    install -D -m 0644 "$F/zeroos-usb-stick.service" "$D/etc/systemd/system/zeroos-usb-stick.service"
    # uinput: BlueZ turns the car's play/skip buttons into key presses with it.
    install -d "$D/etc/modules-load.d"
    printf 'uinput\nlibcomposite\n' > "$D/etc/modules-load.d/zeroos-car.conf"
    # WirePlumber: Bluetooth audio without a login; a phone's music, not its calls.
    install -D -m 0644 "$F/60-zeroos-car.conf" "$D/etc/wireplumber/wireplumber.conf.d/60-zeroos-car.conf"
}
