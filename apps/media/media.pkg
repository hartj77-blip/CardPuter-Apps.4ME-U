# Media (README.md): music player (mpv, part of ZeroOS for Dock), music and
# video from Jellyfin (video plays through libmpv, which comes with mpv).
# Voice notes moved to the Recorder app.
NAME="Media"
SUMMARY="Music player with a classic look, music and video from every Jellyfin library"
APP_VERSION="2.0.0"
DEPENDS="mpv, libmpv2"
NEEDS="mpv"
