# Maps (README.md): an offline map with directions, and the GPS screen
# (position, saved spots, GPX tracks) that was the GPS app. The map of New
# Jersey, its search index and Navit's routing map come in the package
# (prepare.sh builds them from OpenStreetMap data). Navit plans the routes,
# run by the app with Xvfb and a D-Bus of its own (nav.cpp); espeak-ng
# speaks the turns.
NAME="Maps"
SUMMARY="Offline map of New Jersey with spoken turn-by-turn directions, and your position and GPX tracks, with a GPS module"
APP_VERSION="1.2.0"
REPLACES="gps"   # the GPS app, now a screen in Maps (Tab > Position and tracks)
DEPENDS="gpsd, gpsd-clients, navit, xvfb, dbus-daemon, dbus-bin, espeak-ng"
NEEDS="gpsd, Navit, Xvfb, espeak-ng"
# gpsd (as the GPS app had it) starts when a client connects and only reads the receiver while someone watches.
ENABLE="gpsd.socket"
DISABLE_DEPS="gpsd.service"
STOP_ON_REMOVE="gpsd.service"
payload() {
    local f
    for f in zmap search addr navit; do
        [ -s "$WORK/maps/new-jersey.$f" ] || { echo "error: no new-jersey.$f at $WORK/maps (prepare.sh builds it)" >&2; exit 1; }
        install -D -m 0644 "$WORK/maps/new-jersey.$f" "$D/usr/share/zeroos/maps/new-jersey.$f"
    done
    # gpsd reads the UART (Cap LoRa-1262, Grove GPS) and USB GPS dongles.
    install -D -m 0644 "$F/gpsd.default" "$D/usr/share/zeroos/app-overrides/maps/etc/default/gpsd"
}
