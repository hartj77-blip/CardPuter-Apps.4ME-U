# Net Tools (README.md): one app with seven tools (Discover, Ports, Trace, DNS,
# Capture, Netinfo, Share), front-ends for the standard Linux network tools.
NAME="Net Tools"
SUMMARY="Discover devices, scan ports, trace routes, DNS, packet capture, interface info and Ethernet sharing"
APP_VERSION="2.0.1"
# arp-scan + nmap (Discover, Ports), mtr-tiny (Trace), dnsutils (DNS, dig),
# tcpdump (Capture), iproute2 (Netinfo: ip, ss). Share uses NetworkManager,
# which is part of ZeroOS; its "shared" mode needs dnsmasq-base (DHCP and DNS
# for the laptop) and nftables (the NAT rule).
DEPENDS="arp-scan, nmap, mtr-tiny, dnsutils, tcpdump, iproute2, dnsmasq-base, nftables"
payload() {
    # Lets the UI user run the root-only tools (arp-scan, tcpdump) through
    # sudo -n with no password. Removing the app removes the rule.
    install -D -m 0440 "$F/zeroos-net.sudoers" "$D/etc/sudoers.d/zeroos-net"
    # Share's helper: runs as pi, through NetworkManager (polkit allows it).
    install -D -m 0755 "$F/zeroos-share" "$D/usr/bin/zeroos-share"
}
