# Mesh (README.md): Meshtastic text messages over LoRa with the
# Cap LoRa-1262. meshtasticd comes from Meshtastic's openSUSE repository.
NAME="Mesh"
SUMMARY="Meshtastic text messages over LoRa with the Cap LoRa-1262"
APP_VERSION="1.2.2"
DEPENDS="meshtasticd, nftables"
# Off at boot: the Mesh app starts it.
DISABLE_DEPS="meshtasticd.service"
STOP_ON_REMOVE="zeroos-mesh-lan.service meshtasticd.service"
payload() {
    install -D -m 0644 "$F/meshtasticd-cap-lora-1262.yaml" \
                       "$D/etc/meshtasticd/config.d/zeroos-cap-lora-1262.yaml"
    install -D -m 0644 "$F/meshtasticd-zeroos.conf" \
                       "$D/etc/systemd/system/meshtasticd.service.d/zeroos.conf"
    install -D -m 0755 "$F/zeroos-mesh-cap-power" "$D/usr/lib/zeroos/mesh-cap-power"
    # Who can reach the web client and API (zeroos-mesh-firewall).
    install -D -m 0755 "$F/zeroos-mesh-firewall" "$D/usr/lib/zeroos/mesh-firewall"
    install -D -m 0644 "$F/zeroos-mesh-lan.service" "$D/etc/systemd/system/zeroos-mesh-lan.service"
    # Fetched by prepare.sh, which checks its fingerprint.
    install -D -m 0644 "$WORK/meshtastic.asc" "$D/usr/share/keyrings/zeroos-app-mesh.asc"
    install -d "$D/etc/apt/sources.list.d"
    echo 'deb [signed-by=/usr/share/keyrings/zeroos-app-mesh.asc] http://download.opensuse.org/repositories/network:/Meshtastic:/beta/Debian_13/ /' \
        > "$D/etc/apt/sources.list.d/zeroos-app-mesh.list"
}
