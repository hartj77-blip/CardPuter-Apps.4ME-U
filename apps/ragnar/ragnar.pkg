# Ragnar (README.md): a Bjorn-family network reconnaissance tool, packaged to
# run headless on ZeroOS -- the Python service (headlessRagnar.py) in the
# background, its web dashboard on :8000, and a ZeroShell control panel. The
# source is vendored at a pinned commit by prepare.sh.
NAME="Ragnar"
SUMMARY="Bjorn-family network recon: a background service with a web dashboard on :8000"
APP_VERSION="1.0.1"
# Debian's own packages for Ragnar's headless core, so apt resolves them and no
# pip --break-system-packages is needed. The Python web UI and scanners:
# flask + cors + socketio (the dashboard), scapy/python-nmap (scanning),
# paramiko (SSH probes), netifaces, cryptography (the encrypted db), sqlalchemy,
# pandas/numpy, pillow, requests, rich, paho-mqtt, pymysql. The command-line
# tools it drives: nmap, arp-scan, tcpdump, ip/ss (iproute2), iw, rfkill,
# sqlite3, lldpd. rsync copies the code into the writable state dir on start;
# nftables gates who can reach the dashboard.
DEPENDS="python3, python3-flask, python3-flask-cors, python3-flask-socketio, python3-scapy, python3-nmap, python3-paramiko, python3-netifaces, python3-cryptography, python3-sqlalchemy, python3-pandas, python3-numpy, python3-pil, python3-requests, python3-rich, python3-paho-mqtt, python3-pymysql, nmap, arp-scan, tcpdump, iproute2, iw, wireless-tools, rfkill, sqlite3, lldpd, rsync, nftables"
NEEDS="Python, nmap, scapy, tcpdump"
# Not enabled at boot: the Ragnar app starts the service when you turn it on,
# and the dashboard stays firewalled to this device and your tailnet until you
# choose "Allow on this network".
STOP_ON_REMOVE="zeroos-ragnar-lan.service ragnar.service"
payload() {
    # The pristine code tree, read-only. The service copies it into its own
    # writable state dir (/var/lib/ragnar) on first start, because Ragnar keeps
    # its db, config and logs next to its own .py files (db_manager.py and
    # others resolve paths from __file__, not the working directory).
    install -d "$D/usr/lib/zeroos/ragnar"
    cp -a "$WORK/ragnar/." "$D/usr/lib/zeroos/ragnar/"
    find "$D/usr/lib/zeroos/ragnar" -type d -exec chmod 0755 {} +
    find "$D/usr/lib/zeroos/ragnar" -type f -exec chmod 0644 {} +
    # The service, its LAN-access toggle, and the firewall helper.
    install -D -m 0644 "$F/ragnar.service" "$D/etc/systemd/system/ragnar.service"
    install -D -m 0644 "$F/zeroos-ragnar-lan.service" "$D/etc/systemd/system/zeroos-ragnar-lan.service"
    install -D -m 0755 "$F/zeroos-ragnar-firewall" "$D/usr/lib/zeroos/ragnar-firewall"
    # Let ZeroShell (pi) start and stop the service without root (like Router).
    install -D -m 0644 "$F/91-zeroos-ragnar.rules" "$D/etc/polkit-1/rules.d/91-zeroos-ragnar.rules"
    # Credits for the vendored source.
    install -D -m 0644 "$F/THIRD_PARTY.md" "$D/usr/share/doc/zeroos-app-ragnar/THIRD_PARTY.md"
}
